%# Translate the Quick Assign widget's form field into standard ticket
%# update arguments so the core TicketUpdate helper processes them with
%# its usual rights checks and notifications.
<%INIT>
my $value = $ARGSRef->{QuickAssign};
return unless defined $value && $value =~ /^(Owner|AdminCc|Cc|Requestor):(\d+)$/;
my ( $type, $user_id ) = ( $1, $2 );

if ( $type eq 'Owner' ) {
    $ARGSRef->{Owner}            = $user_id;
    $ARGSRef->{ForceOwnerChange} = 1;
}
else {
    $ARGSRef->{ 'Ticket-AddWatcher-Principal-' . $user_id } = $type;
}
</%INIT>
<%ARGS>
$ARGSRef => undef
</%ARGS>
