%# Render a small remove button next to each AdminCc, Cc and Requestor
%# in the People box. Deletes the watcher via the core TicketUpdate
%# helper; the People box refreshes itself through the resulting
%# ticketWatchersChanged event.
<button type="button" class="btn btn-link p-0 align-baseline ms-1"
  hx-post="<% RT->Config->Get('WebPath') %>/Helpers/TicketUpdate"
  hx-vals='{"id":<% $Ticket->id %>,"Ticket-DeleteWatcher-Type-<% $type %>-Principal-<% $User->PrincipalId %>":1}'
  hx-swap="none"
><% GetSVGImage( Name => 'close', Title => loc( 'Remove [_1] as [_2]', $User->Format, loc($type) ), Size => 12 ) |n %></button>
<%INIT>
return unless $Ticket && $User && $Group && ref($Group) && $Group->isa('RT::Group');

# The mobile UI renders watchers through this component as well, but
# does not load htmx, so the button would be dead there.
return if $m->request_path =~ m{^/m(?:/|$)};

my $type = $Group->Name // '';
return unless $type =~ /^(?:AdminCc|Cc|Requestor)$/;

return unless $Ticket->CurrentUserHasRight('ModifyTicket');
</%INIT>
<%ARGS>
$User   => undef
$Ticket => undef
$Group  => undef
</%ARGS>
